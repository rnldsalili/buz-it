{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buz It",
  "version": "0.1.0",
  "identifier": "dev.buzit.app",
  "build": {
    "beforeDevCommand": {
      "script": "npm run build --prefix ../web",
      "cwd": ".",
      "wait": true
    },
    "beforeBuildCommand": {
      "script": "npm run build --prefix ../web",
      "cwd": "."
    },
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Buz It",
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:*; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; img-src 'self' data: http://127.0.0.1:*; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "targets": [
      "app"
    ]
  }
}
